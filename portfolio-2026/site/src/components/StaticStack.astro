<div class="stack" aria-hidden="true">
  <div class="stack__deck">
    <div class="stack__sheet stack__sheet--signal">
      <span class="sheet__label sheet__label--acid">04 Signal</span>
      <div class="mini">
        <span class="mini__kicker">Engagement · 6 months</span>
        <div class="mini__balance">+42%</div>
        <div class="mini__bar mini__bar--wide"></div>
        <div class="mini__bar mini__bar--mid"></div>
        <div class="mini__chart">
          <span style="height: 26%"></span>
          <span style="height: 42%"></span>
          <span style="height: 36%"></span>
          <span style="height: 64%"></span>
          <span style="height: 88%"></span>
        </div>
        <div class="mini__swatches" style="margin-top: 6px;">
          <span style="background: var(--cobalt);"></span>
          <span style="background: var(--acid);"></span>
          <span style="background: var(--ink);"></span>
        </div>
      </div>
    </div>

    <div class="stack__sheet stack__sheet--system">
      <span class="sheet__label">03 System</span>
      <div class="mini">
        <span class="mini__kicker">Module library</span>
        <div class="mini__bar mini__bar--wide"></div>
        <div class="mini__grid">
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
        </div>
        <div class="mini__swatches">
          <span style="background: var(--cobalt);"></span>
          <span style="background: var(--acid);"></span>
          <span style="background: var(--paper-deep);"></span>
          <span style="background: var(--ink);"></span>
        </div>
        <div class="mini__bar mini__bar--mid"></div>
      </div>
    </div>

    <div class="stack__sheet stack__sheet--structure">
      <span class="sheet__label">02 Structure</span>
      <div class="mini">
        <span class="mini__kicker">Flow · states · hierarchy</span>
        <div class="mini__bar mini__bar--short"></div>
        <div class="mini__wire">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="mini__bar mini__bar--mid"></div>
        <div class="mini__bar mini__bar--wide"></div>
      </div>
    </div>

    <div class="stack__sheet stack__sheet--surface">
      <span class="sheet__label">01 Interface</span>
      <div class="mini">
        <div class="mini__topbar"></div>
        <span class="mini__kicker">Your balance</span>
        <div class="mini__balance">2,480 pts</div>
        <div class="mini__tiles">
          <span class="mini__tile"></span>
          <span class="mini__tile"></span>
          <span class="mini__tile"></span>
          <span class="mini__tile"></span>
        </div>
        <div class="mini__reward">
          <span class="mini__kicker" style="color: rgba(244, 241, 234, 0.55);">Weekend multiplier</span>
          <strong>3.2×</strong>
        </div>
      </div>
    </div>
  </div>
</div>

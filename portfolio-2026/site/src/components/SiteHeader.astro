---
import Icon from './Icon.astro';
import { nav, site } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = path.startsWith('/work')
  ? 'work'
  : path.startsWith('/systems')
    ? 'systems'
    : path.startsWith('/about')
      ? 'about'
      : '';

const menuLinks = [
  { label: 'Work', href: '/#work', num: '01' },
  { label: 'Systems', href: '/systems', num: '02' },
  { label: 'About', href: '/about', num: '03' },
  { label: 'Résumé', href: '/resume', num: '04' },
  { label: 'Contact', href: '/#contact', num: '05' },
];
---

<header class="site-head" data-header>
  <div class="wrap head-inner">
    <a class="wordmark" href="/" aria-label="Monalisha Chatterjee, home">
      Monalisha Chatterjee
      <span>Product designer</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {nav.map((item) => {
        const key = item.label.toLowerCase();
        const current = active === key;
        return (
          <a href={item.href} aria-current={current ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="head-actions">
      <span class="availability"><span class="dot"></span>{site.availability}</span>
      <a class="head-link" href="/resume">Résumé</a>
      <a class="btn btn--sm" href="/#contact">Contact <Icon name="arrow-up-right" size={13} /></a>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-open
      >
        <span>Menu</span>
        <span class="menu-btn__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" data-menu aria-hidden="true" inert>
  <div class="menu__top">
    <a class="wordmark" href="/">Monalisha Chatterjee</a>
    <button class="menu__close" type="button" data-menu-close aria-label="Close menu">
      <Icon name="close" size={18} />
    </button>
  </div>

  <nav class="menu__links" aria-label="Mobile">
    {menuLinks.map((item) => (
      <a href={item.href} data-menu-link><span>{item.num}</span>{item.label}</a>
    ))}
  </nav>

  <div class="menu__foot mono">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <span>{site.location} · {site.timezone}</span>
  </div>
</div>
